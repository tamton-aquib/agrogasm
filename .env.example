# Copy to .env and fill in. Never commit real keys.
# Backend
AGROGASM_DB=agrogasm.db
AGROGASM_THRESHOLD=10
FRONTEND_ORIGIN=http://127.0.0.1:5173
FLASK_DEBUG=1

# Frontend (Vite only reads VITE_ prefixed vars)
VITE_API_URL=http://127.0.0.1:5000
VITE_OWM_KEY=your_openweathermap_key_here
VITE_OWM_CITY=Kottayam
